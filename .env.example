# Free-tier Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Model id (check the current free-tier list; ids change often)
VERBADB_MODEL=gemini-3.8-flash

# SHARED databases everyone using the app can query (read-only): JSON object of name -> pyflashdb URL.
# Optional: people can also create their own sandbox databases and connect their own ones in the UI.
# Use a READ-ONLY database account — it is the real backstop behind the in-code guard.
VERBADB_DATABASES={"demo": "sqlite:///demo.db"}

# Where the app keeps its own data: sandbox databases, undo snapshots, saved prompts, connection list.
# (A URL someone adds in the UI, including its password, is stored here in plain text — treat the folder like this .env file.)
VERBADB_DATA_DIR=verbadb_data

# Per-person workspaces (each browser gets a private one: its sandboxes, connections and prompt history)
VERBADB_MAX_DATABASES=8
VERBADB_SANDBOX_MAX_MB=20
VERBADB_MAX_SAVED_PROMPTS=500
# May people connect their own databases from the UI? Defaults to true on 127.0.0.1 and false on a network-facing host.
# VERBADB_ALLOW_USER_CONNECTIONS=true
# ...and may those point at localhost / private networks? (same defaults)
# VERBADB_ALLOW_PRIVATE_DB_HOSTS=true

# Agent limits (each step is one Gemini request; the free tier is quota-limited)
VERBADB_MAX_STEPS=8
VERBADB_MAX_ROWS=500
VERBADB_QUERY_TIMEOUT=15

# Data minimisation: free-tier prompts may be used by Google to improve its products.
# Rows of each result sent to the model (0 = send none, the model sees aggregates/counts only)
VERBADB_PREVIEW_ROWS=20
# Columns whose values are masked before anything is sent to the model (UI still shows real values)
VERBADB_REDACT_COLUMNS=email,phone,ssn,password,token,secret

# Web server
VERBADB_HOST=127.0.0.1
VERBADB_PORT=8000
